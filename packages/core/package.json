{
  "name": "@guardrail/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config/index.ts",
    "./logging": "./src/logging/index.ts",
    "./errors": "./src/errors/index.ts",
    "./types": "./src/types/index.ts",
    "./db": "./src/db/index.ts",
    "./ai": "./src/ai/index.ts",
    "./knowledge": "./src/knowledge/index.ts",
    "./rules": "./src/rules/index.ts",
    "./agents": "./src/agents/index.ts",
    "./orchestrator": "./src/orchestrator/index.ts",
    "./audit": "./src/audit/index.ts",
    "./campaigns": "./src/campaigns/index.ts",
    "./audience": "./src/audience/index.ts",
    "./analyses": "./src/analyses/index.ts",
    "./human-review": "./src/human-review/index.ts",
    "./feedback": "./src/feedback/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "db:ingest": "tsx --env-file=../../.env src/knowledge/ingest-cli.ts",
    "db:studio": "drizzle-kit studio",
    "evaluate": "tsx --env-file=../../.env src/evaluation/run.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.29.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
