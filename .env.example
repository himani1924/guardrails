# === Database ===
# Local Docker Compose defaults (pgvector/pgvector:pg16). Postgres must have pgvector.
DATABASE_URL=postgres://guardrail:guardrail@localhost:5432/guardrail

# === Application ===
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000

# === AI providers ===
# The provider is selected by name. Only the keys for the active provider
# are required. `mock` requires no keys and is the default in tests.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# Uncomment and fill for OpenAI:
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === Embeddings / pgvector ===
# Output size requested from every embedding provider. Must equal the
# knowledge_chunks.embedding vector(768) column. Run `npm run db:reembed`
# after changing EMBEDDING_PROVIDER.
# EMBEDDING_DIMENSION=768

# === Human review ===
# Single hard-coded reviewer identity for the MVP.
DEFAULT_REVIEWER_ID=reviewer-demo
DEFAULT_REVIEWER_NAME=Demo Reviewer

# Google Gemini (free AI Studio key) — recommended when OpenAI credits are empty:
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_LLM_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# === Images ===
# Image extraction uses the active LLM_PROVIDER's *_LLM_MODEL (no separate
# vision setting), so that model must accept images (e.g. gpt-4o-mini or a
# Gemini flash model). The mock returns a fixed, text-free description.
