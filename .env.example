# === Database ===
# Local Docker Compose defaults. Override for cloud deployments.
DATABASE_URL=postgres://guardrail:guardrail@localhost:5432/guardrail

# === Application ===
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000

# === AI providers ===
# The provider is selected by name. Only the keys for the active provider
# are required. `mock` requires no keys and is the default in tests.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# Uncomment and fill for OpenAI:
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === Human review ===
# Single hard-coded reviewer identity for the MVP.
DEFAULT_REVIEWER_ID=reviewer-demo
DEFAULT_REVIEWER_NAME=Demo Reviewer
