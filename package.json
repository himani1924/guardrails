{
  "name": "guardrail",
  "version": "0.1.0",
  "private": true,
  "description": "Guardrail — agentic marketing compliance and audience-risk review platform (MVP).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs}\"",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "npm --workspace @guardrail/core run db:generate",
    "db:migrate": "npm --workspace @guardrail/core run db:migrate",
    "db:seed": "npm --workspace @guardrail/core run db:seed",
    "db:ingest": "npm --workspace @guardrail/core run db:ingest",
    "db:studio": "npm --workspace @guardrail/core run db:studio",
    "evaluate": "npm --workspace @guardrail/core run evaluate"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
